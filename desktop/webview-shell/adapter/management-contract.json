        "hasToolHistory": "bool",
        "messageCount": "int1..10000",
        "toolCount": "int0..1000",
        "stream": "bool",
        "multiRole": "bool",
        "explicitParameters": "array<id>"
      }
    },
    "wb.settings": {
      "values": {
        "autoMigrateSessions": "bool",
        "autoTasks": "bool"
      }
    },
    "wb.profile": {
      "accountId": "required",
      "values": {
        "label": "text128",
