        "taskCodes": "array<text256>"
      }
    },
    "wb.tasksCancel": {
      "jobId": "required UUID",
      "values": {}
    },
    "wb.rotation": {
      "values": {
        "enabled": "bool",
        "target": "gateway|codebuddy-cli|both",
        "strategy": "expiry|round_robin",
        "intervalMinutes": "int1..1440",
