+import { describe, expect, it } from 'vitest'
+import {modelDisplayParts, displayModelName, formatModelPillLabel} from './model-status-label'
+const labels = {"workbuddy": "WB国内", "workbuddy-ai": "WB国际", "trae-code-cn": "Trae国内", "trae": "Trae国际", "minimax": "MiniMax", "minimax-native": "MiniMax客户端", "codebuddy-cn": "CodeBuddy国内", "qoder-cn": "Qoder国内", "qoder-global": "Qoder国际", "qwenwork-native": "千问办公", "zcode-native": "ZCode", "nvidia-main": "NVIDIA", "cline-main": "Cline", "kilo-free": "Kilo", "opencode-zen": "OpenCode", "lobster-main": "Lobster", "loomy-main": "Loomy", "raccoon-main": "小浣熊", "antigravity-main": "Antigravity", "bigmodel-official": "智谱官方", "codearts-main": "CodeArts"}
+describe('gateway source prefixes', () => {
+ for (const [source, label] of Object.entries(labels)) {
+  it(`menu and composer distinguish ${source}`, () => {
+   const id = `${source}/deepseek-v4.1-flash`
+   expect(modelDisplayParts(id, 'custom:ai-credit')).toEqual({name:`${label} · DeepSeek V4.1`, tag:'Flash'})
+   expect(displayModelName(id, 'ai-credit')).toBe(`${label} · DeepSeek V4.1 Flash`)
+   expect(formatModelPillLabel(id, {provider:'custom:ai-credit'})).toBe(`${label} · DeepSeek V4.1 · Flash`)
+  })
+ }
+ it('keeps duplicate GLM entries distinct by source', () => {
+  expect(displayModelName('workbuddy/glm-5.3','custom:ai-credit')).not.toBe(displayModelName('trae-code-cn/glm-5.3','custom:ai-credit'))
+ })
+ it('preserves tags and nested vendor model ids', () => {
+  expect(modelDisplayParts('cline-main/deepseek/deepseek-v4.1-flash','custom:ai-credit')).toEqual({name:'Cline · DeepSeek V4.1',tag:'Flash'})
+  expect(formatModelPillLabel('minimax-native/MiniMax-M3.1-Flash-Preview',{provider:'custom:ai-credit'})).toBe('MiniMax客户端 · MiniMax M3.1 Flash · Preview')
+  expect(formatModelPillLabel('workbuddy/glm-5.3',{provider:'custom:ai-credit',serviceTier:'ultrafast'})).toBe('WB国内 · GLM 5.3 · Ultrafast')
+ })
+ it('does not expose individual WorkBuddy account aliases', () => {
+  expect(displayModelName('wb-SAMPLE_ACCOUNT/glm-5.3','custom:ai-credit')).toBe('WB国内独立号 · GLM 5.3')
+ })
+ it('keeps unknown gateway namespaces visible instead of guessing a platform', () => {
+  expect(displayModelName('SAMPLE-new-agent/glm-5.3','custom:ai-credit')).toBe('SAMPLE-new-agent · GLM 5.3')
+ })
+ it('leaves ordinary providers and unscoped model labels unchanged', () => {
+  expect(displayModelName('minimax/minimax-01')).toBe('MiniMax 01')
+  expect(displayModelName('workbuddy/glm-5.3','openrouter')).toBe('GLM 5.3')
+  expect(displayModelName('anthropic/claude-opus-4.8-fast','custom:other')).toBe('Opus 4.8 Fast')
+  expect(displayModelName('glm-5.3','custom:ai-credit')).toBe('GLM 5.3')
+ })
+})
