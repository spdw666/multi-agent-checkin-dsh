+
+function gatewayModelSource(model: string, provider?: string): string {
+  if (provider !== 'ai-credit' && provider !== 'custom:ai-credit') return ''
+  const trimmed = model.trim()
+  const slash = trimmed.indexOf('/')
+  if (slash < 1) return ''
+  const source = trimmed.slice(0, slash)
+  return GATEWAY_MODEL_SOURCES[source] ?? (source.startsWith('wb-') ? 'WB国内独立号' : source)
+}
